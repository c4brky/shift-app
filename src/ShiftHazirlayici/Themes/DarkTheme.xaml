<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Anthracite Dark Gray Palette -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="#141518"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#1C1E22"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#24272C"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2D3138"/>
    <SolidColorBrush x:Key="ControlBgBrush" Color="#181A1E"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3B404A"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2F333B"/>
    <SolidColorBrush x:Key="NavPillContainerBrush" Color="#22252A"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#1E2B42"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A8B4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7785"/>

    <SolidColorBrush x:Key="WarningBgBrush" Color="#2E2412"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#78571A"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D"/>

    <SolidColorBrush x:Key="ErrorBgBrush" Color="#33171D"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#7F1D2B"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5"/>

    <SolidColorBrush x:Key="SuccessBgBrush" Color="#122B22"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6EE7B7"/>

</ResourceDictionary>
