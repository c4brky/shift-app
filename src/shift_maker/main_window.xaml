<!-- created by c4brky -->
<Window x:Class="ShiftMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SHIFT MAKER"
        Icon="pack://application:,,,/assets/app.ico"
        Width="1360"
        Height="840"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: SPLIT TOP BAR (2 parts aligned with left & right columns) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="340" MaxWidth="460"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOP-LEFT CARD: Logo + Save Folder -->
            <Border Grid.Column="0" Style="{StaticResource FluentCard}" Padding="10,8">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Background="#F4F5F8"
                            BorderBrush="#3B404A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Width="34"
                            Height="34"
                            Padding="4"
                            Margin="0,0,8,0"
                            ToolTip="SHIFT MAKER">
                        <Image Source="pack://application:,,,/assets/b_logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Border Background="{DynamicResource SubtleFillBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button x:Name="BtnSelectFolder"
                                        Content="Seç"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4"
                                        FontSize="11.5"
                                        Margin="0,0,4,0"
                                        Click="BtnSelectFolder_Click"/>
                                <Button x:Name="BtnOpenFolder"
                                        Content="Aç"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4"
                                        FontSize="11.5"
                                        Click="BtnOpenFolder_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSaveLabel"
                                           Text="📁 Kayıt:"
                                           FontWeight="SemiBold"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtSaveFolder"
                                           Text="..."
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           MaxWidth="135"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- TOP-RIGHT CARD: Nav Tabs + Date Pickers + Flag Language + Customize + Generate -->
            <Border Grid.Column="2" Style="{StaticResource FluentCard}" Padding="10,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource NavPillContainerBrush}" CornerRadius="9" Padding="3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabPlanner"
                                             Content="📋 Planlayıcı"
                                             Style="{StaticResource NavTabButton}"
                                             IsChecked="True"
                                             Checked="NavTab_Changed"/>
                                <RadioButton x:Name="TabHistory"
                                             Content="🗂 Geçmiş (0)"
                                             Style="{StaticResource NavTabButton}"
                                             Checked="NavTab_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource NavPillContainerBrush}" CornerRadius="8" Padding="4,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPrevWeek"
                                        Content="◀"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="7,4"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Click="BtnPrevWeek_Click"/>
                                <DatePicker x:Name="DpStartDate"
                                            Width="106"
                                            Margin="4,0,2,0"
                                            VerticalAlignment="Center"
                                            SelectedDateChanged="DpStartDate_SelectedDateChanged"/>
                                <TextBlock Text="→"
                                           VerticalAlignment="Center"
                                           Margin="4,0"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <DatePicker x:Name="DpEndDate"
                                            Width="106"
                                            Margin="2,0,4,0"
                                            VerticalAlignment="Center"
                                            SelectedDateChanged="DpEndDate_SelectedDateChanged"/>
                                <Button x:Name="BtnNextWeek"
                                        Content="▶"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="7,4"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Click="BtnNextWeek_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLanguage"
                                Content="TR"
                                Width="38"
                                Height="34"
                                Padding="0"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="BtnLanguage_Click"/>
                        <Button x:Name="BtnCustomize"
                                Content="⚙ ÖZELLEŞTİR"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Click="BtnCustomize_Click"/>
                        <Button x:Name="BtnGenerate"
                                Content="✨ OLUŞTUR"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,7"
                                Click="BtnGenerate_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ROW 1A: WORKSPACE -->
        <Grid x:Name="PanelPlanner" Grid.Row="1" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="340" MaxWidth="460"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Style="{StaticResource FluentCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource NavPillContainerBrush}" CornerRadius="9" Padding="3" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="SubTabTeam"
                                         Grid.Column="0"
                                         Content="👥 Ekip &amp; İzinler"
                                         Style="{StaticResource NavTabButton}"
                                         IsChecked="True"
                                         Checked="LeftSubTab_Changed"/>
                            <RadioButton x:Name="SubTabHoursFull"
                                         Grid.Column="1"
                                         Content="⏰ Saatler &amp; Full"
                                         Style="{StaticResource NavTabButton}"
                                         Checked="LeftSubTab_Changed"/>
                        </Grid>
                    </Border>

                    <!-- SUB-PANEL 1: TEAM & LEAVE -->
                    <ScrollViewer x:Name="PanelLeftTeam"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel x:Name="LeftTeamStack">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="TxtStaffListTitle"
                                           DockPanel.Dock="Left"
                                           Text="Personel Listesi (3–30)"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button x:Name="BtnAddPerson"
                                        DockPanel.Dock="Right"
                                        Content="+ Kişi Ekle"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="10,5"
                                        Click="BtnAddPerson_Click"/>
                            </DockPanel>

                            <Border x:Name="BannerOverlapWarning"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource ErrorBgBrush}"
                                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,7"
                                    Margin="0,0,0,8">
                                <TextBlock x:Name="TxtOverlapWarning"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource ErrorTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel x:Name="PersonRowsPanel"/>

                            <Expander Style="{StaticResource ModernExpander}"
                                      IsExpanded="True"
                                      Margin="0,6,0,2"
                                      Expanded="ExpanderLayout_Changed"
                                      Collapsed="ExpanderLayout_Changed">
                                <Expander.Header>
                                    <TextBlock x:Name="TxtBulkLeaveHeader" Text="Toplu İzin &amp; Kapsam" FontWeight="SemiBold" FontSize="12.5"/>
                                </Expander.Header>
                                <StackPanel>
                                    <CheckBox x:Name="ChkBulkLastDay"
                                              Content="Toplu Pazar İzni"
                                              FontWeight="SemiBold"
                                              Margin="0,2,0,7"
                                              Checked="QuickLeaveOption_Changed"
                                              Unchecked="QuickLeaveOption_Changed"/>
                                    <CheckBox x:Name="ChkNoLeaveAll"
                                              Content="İzinleri Kapat"
                                              Margin="0,0,0,9"
                                              Checked="QuickLeaveOption_Changed"
                                              Unchecked="QuickLeaveOption_Changed"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="BtnAllRandomLeave"
                                                Content="Herkes Rastgele"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,5"
                                                FontSize="11.5"
                                                Margin="0,2,6,2"
                                                Click="BtnAllRandomLeave_Click"/>
                                        <ComboBox x:Name="CmbQuickLeaveScope"
                                                  Width="175"
                                                  Margin="0,2,0,2"
                                                  FontSize="11.5"
                                                  SelectionChanged="CmbQuickLeaveScope_SelectionChanged"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SUB-PANEL 2: HOURS & FULL -->
                    <ScrollViewer x:Name="PanelLeftHoursFull"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel x:Name="LeftHoursFullStack">
                            <Expander Style="{StaticResource ModernExpander}"
                                      IsExpanded="True"
                                      Margin="0,0,0,10"
                                      Expanded="ExpanderLayout_Changed"
                                      Collapsed="ExpanderLayout_Changed">
                                <Expander.Header>
                                    <TextBlock x:Name="TxtWorkHoursHeader" Text="Mesai Saatleri (07–22)" FontWeight="SemiBold" FontSize="13"/>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock x:Name="LblMainMorning" Text="Sabahçı" FontWeight="SemiBold" Foreground="#7DD3FC" Margin="0,0,0,4"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <ComboBox x:Name="MainMorningSH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainMorningSM" Width="54" Margin="2,1,6,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="2,0,6,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="MainMorningEH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainMorningEM" Width="54" Margin="2,1,0,1" SelectionChanged="MainHourCombo_Changed"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="LblMainMid" Text="Ara Shift" FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,0,0,4"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <ComboBox x:Name="MainMidSH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainMidSM" Width="54" Margin="2,1,6,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="2,0,6,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="MainMidEH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainMidEM" Width="54" Margin="2,1,0,1" SelectionChanged="MainHourCombo_Changed"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="LblMainEvening" Text="Akşamcı" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,4"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <ComboBox x:Name="MainEveningSH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainEveningSM" Width="54" Margin="2,1,6,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="2,0,6,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="MainEveningEH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainEveningEM" Width="54" Margin="2,1,0,1" SelectionChanged="MainHourCombo_Changed"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="LblMainFull" Text="Full Kalma" FontWeight="SemiBold" Foreground="#FDA4AF" Margin="0,0,0,4"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <ComboBox x:Name="MainFullSH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainFullSM" Width="54" Margin="2,1,6,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="2,0,6,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="MainFullEH" Width="54" Margin="0,1,2,1" SelectionChanged="MainHourCombo_Changed"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="MainFullEM" Width="54" Margin="2,1,0,1" SelectionChanged="MainHourCombo_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>

                            <Border Background="{DynamicResource SubtleFillBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkEnableFullMain"
                                              FontWeight="SemiBold"
                                              Checked="ChkEnableFullMain_Changed"
                                              Unchecked="ChkEnableFullMain_Changed">
                                        <TextBlock x:Name="TxtEnableFullMain" Text="Full Kalma Ekle" FontWeight="SemiBold" FontSize="13"/>
                                    </CheckBox>

                                    <StackPanel x:Name="MainFullDaysContainer" Visibility="Collapsed" Margin="0,10,0,0">
                                        <StackPanel x:Name="MainFullDaysPanel"/>
                                        <Button x:Name="BtnClearMainFull"
                                                Content="Full Seçimlerini Temizle"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Margin="0,4,0,0"
                                                Click="BtnClearMainFull_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT MAIN CANVAS -->
            <Border Grid.Column="2" Style="{StaticResource FluentCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTableTitle"
                                           Text="2026 - 11.23/11.29"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border x:Name="BadgeScheduleState"
                                        Background="{DynamicResource SubtleFillBrush}"
                                        CornerRadius="6"
                                        Padding="9,3"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtScheduleState"
                                               Text="Taslak"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtTableSubtitle"
                                       Visibility="Collapsed"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenExportedImage"
                                    Content="🖼 Görseli Aç"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="Collapsed"
                                    Margin="0,0,6,0"
                                    Click="BtnOpenExportedImage_Click"/>
                            <Button x:Name="BtnReExportImage"
                                    Content="💾 Yeniden Dışa Aktar"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="Collapsed"
                                    Click="BtnReExportImage_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="8,3" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtStatusPeople" Text="👥 5 / 30 Kişi" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="6" Padding="8,3" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtStatusLeave" Text="🌴 İzin: Rastgele" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Padding="8,3" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtStatusHistory" Text="🕒 Son 2 Hafta: 0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Padding="8,3" Margin="0,2,6,2">
                            <TextBlock x:Name="TxtStatusExport" Text="🖼 PNG" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="6" Padding="8,3" Margin="0,2,0,2">
                            <TextBlock x:Name="TxtStatusAutoSave" Text="💾 Otomatik Kayıt" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </WrapPanel>

                    <Border x:Name="BannerScheduleNotes"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningBgBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="TxtScheduleNotes"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Grid.Row="3"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True"
                                VerticalAlignment="Top">
                            <Grid x:Name="ShiftTableGrid"/>
                        </Border>
                    </ScrollViewer>

                    <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <Border x:Name="GiftMessagePill"
                                    Width="0"
                                    Opacity="0"
                                    ClipToBounds="True"
                                    Background="#351621"
                                    BorderBrush="#E11D48"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGiftMessage"
                                           Text="c4brky &lt;3"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FDA4AF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="12,0"
                                           TextWrapping="NoWrap"/>
                            </Border>
                            <Button x:Name="BtnSecretHeart"
                                    Width="30"
                                    Height="30"
                                    Cursor="Hand"
                                    ToolTip="♥"
                                    Click="BtnSecretHeart_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="HeartBd"
                                                Background="#24272C"
                                                BorderBrush="#3B404A"
                                                BorderThickness="1"
                                                CornerRadius="15">
                                            <TextBlock x:Name="HeartGlyph"
                                                       Text="♥"
                                                       FontSize="13.5"
                                                       Foreground="#FB7185"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeartBd" Property="Background" Value="#351621"/>
                                                <Setter TargetName="HeartBd" Property="BorderBrush" Value="#E11D48"/>
                                                <Setter TargetName="HeartGlyph" Property="Foreground" Value="#FDA4AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <WrapPanel VerticalAlignment="Center">
                            <Border x:Name="PillLegendMorning" CornerRadius="7" BorderThickness="1" Padding="10,4" Margin="0,2,8,2">
                                <TextBlock x:Name="LegendMorning" Text="● Sabahçı: 09:00 - 18:00" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="PillLegendMid" CornerRadius="7" BorderThickness="1" Padding="10,4" Margin="0,2,8,2">
                                <TextBlock x:Name="LegendMid" Text="● Ara Shift: 11:00 - 20:00" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="PillLegendEvening" CornerRadius="7" BorderThickness="1" Padding="10,4" Margin="0,2,8,2">
                                <TextBlock x:Name="LegendEvening" Text="● Akşamcı: 13:00 - 22:00" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="PillLegendFull" CornerRadius="7" BorderThickness="1" Padding="10,4" Margin="0,2,8,2" Visibility="Collapsed">
                                <TextBlock x:Name="LegendFull" Text="● FULL: 09:00 - 22:00" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="PillLegendOff" CornerRadius="7" BorderThickness="1" Padding="10,4" Margin="0,2,0,2">
                                <TextBlock x:Name="LegendOff" Text="● İZİN: Dinlenme" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 1B: HISTORY SCREEN -->
        <Border x:Name="PanelHistory" Grid.Row="1" Style="{StaticResource FluentCard}" Visibility="Collapsed" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtHistoryTitle"
                               DockPanel.Dock="Left"
                               Text="🗂 Geçmiş Shift Kayıtları"
                               FontSize="17"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="BtnClearAllHistory"
                            DockPanel.Dock="Right"
                            Content="🗑 Tüm Geçmişi Temizle"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BtnClearAllHistory_Click"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ROW 2: COLLAPSIBLE DYNAMIC RULES FOOTER -->
        <Expander Grid.Row="2"
                  Style="{StaticResource ModernExpander}"
                  IsExpanded="False"
                  Margin="0,10,0,0"
                  Expanded="ExpanderLayout_Changed"
                  Collapsed="ExpanderLayout_Changed">
            <Expander.Header>
                <TextBlock x:Name="TxtRulesFooterTitle"
                           Text="📌 Aktif Kurallar"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Expander.Header>
            <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RulesListControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                <TextBlock Text="•"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>

    </Grid>
</Window>
