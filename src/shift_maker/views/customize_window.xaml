<!-- created by c4brky -->
<Window x:Class="ShiftMaker.Views.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SHIFT MAKER — Customize"
        Icon="pack://application:,,,/assets/app.ico"
        Width="760"
        Height="720"
        MinWidth="580"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + GitHub Info Link -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="BtnGitHubInfo"
                    DockPanel.Dock="Right"
                    Width="30"
                    Height="30"
                    Margin="10,2,0,0"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    ToolTip="GitHub — c4brky/shift-maker"
                    Click="BtnGitHubInfo_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InfoBd"
                                Background="#132238"
                                BorderBrush="#2563EB"
                                BorderThickness="1"
                                CornerRadius="15">
                            <TextBlock x:Name="InfoGlyph"
                                       Text="i"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       FontStyle="Italic"
                                       Foreground="#60A5FA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoBd" Property="Background" Value="#1D3557"/>
                                <Setter TargetName="InfoBd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="InfoGlyph" Property="Foreground" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock x:Name="TxtHeaderTitle"
                       DockPanel.Dock="Left"
                       Text="⚙ Özelleştirme"
                       FontSize="19"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </DockPanel>

        <!-- Collapsible Sections -->
        <ScrollViewer x:Name="MainScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel x:Name="SectionsStack">

                <!-- 1. Shift Colors -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="TxtColorsHeader"
                                   Text="🎨 Shift Renkleri"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel x:Name="ColorPickersPanel"/>
                    </StackPanel>
                </Border>

                <!-- 2. Work Hours -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="0">
                    <StackPanel>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="11" Padding="14,10">
                            <CheckBox x:Name="ChkCustomHours"
                                      IsChecked="{Binding EnableCustomHours, Mode=TwoWay}"
                                      Checked="SectionToggle_Changed"
                                      Unchecked="SectionToggle_Changed">
                                <TextBlock x:Name="TxtCustomHoursHeader"
                                           Text="Mesai Saatleri (07:00 – 22:00)"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Border>
                        <Border Padding="14,12,14,14"
                                Visibility="{Binding IsChecked, ElementName=ChkCustomHours, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblMorning" Grid.Column="0" Text="Sabahçı:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#7DD3FC"/>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbMorningStartH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbMorningStartM" Width="58" Margin="2,2,8,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0,10,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbMorningEndH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbMorningEndM" Width="58" Margin="2,2,0,2" SelectionChanged="AnyTimeChanged"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblMid" Grid.Column="0" Text="Ara Shift:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FBBF24"/>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbMidStartH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbMidStartM" Width="58" Margin="2,2,8,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0,10,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbMidEndH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbMidEndM" Width="58" Margin="2,2,0,2" SelectionChanged="AnyTimeChanged"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblEvening" Grid.Column="0" Text="Akşamcı:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#D1D5DB"/>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbEveningStartH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbEveningStartM" Width="58" Margin="2,2,8,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0,10,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbEveningEndH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbEveningEndM" Width="58" Margin="2,2,0,2" SelectionChanged="AnyTimeChanged"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblFull" Grid.Column="0" Text="Full Kalma:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FDA4AF"/>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbFullStartH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbFullStartM" Width="58" Margin="2,2,8,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0,10,0" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbFullEndH" Width="58" Margin="0,2,2,2" SelectionChanged="AnyTimeChanged"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold"/>
                                        <ComboBox x:Name="CmbFullEndM" Width="58" Margin="2,2,0,2" SelectionChanged="AnyTimeChanged"/>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Full Shift -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="0">
                    <StackPanel>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="11" Padding="14,10">
                            <CheckBox x:Name="ChkEnableFullShifts"
                                      IsChecked="{Binding EnableFullShifts, Mode=TwoWay}"
                                      Checked="SectionToggle_Changed"
                                      Unchecked="SectionToggle_Changed">
                                <TextBlock x:Name="TxtFullHeader"
                                           Text="Full Kalma (İsteğe Bağlı)"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Border>
                        <StackPanel Margin="14,12,14,14"
                                    Visibility="{Binding IsChecked, ElementName=ChkEnableFullShifts, Converter={StaticResource BoolToVis}}">
                            <StackPanel x:Name="FullDaysPanel"/>
                            <Button x:Name="BtnClearFull"
                                    Content="Tüm Full Seçimlerini Temizle"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Padding="10,5"
                                    FontSize="11.5"
                                    Margin="0,6,0,0"
                                    Click="BtnClearFullSelections_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Leave Rules -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="0">
                    <StackPanel>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="11" Padding="14,10">
                            <CheckBox x:Name="ChkLeaveCustomization"
                                      IsChecked="{Binding EnableLeaveCustomization, Mode=TwoWay}"
                                      Checked="SectionToggle_Changed"
                                      Unchecked="SectionToggle_Changed">
                                <TextBlock x:Name="TxtLeaveHeader"
                                           Text="İzin Kuralları &amp; Toplu Seçim"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Border>
                        <StackPanel Margin="14,12,14,14"
                                    Visibility="{Binding IsChecked, ElementName=ChkLeaveCustomization, Converter={StaticResource BoolToVis}}">
                            <CheckBox x:Name="ChkCustBulkLastDay"
                                      Content="Toplu Pazar İzni"
                                      IsChecked="{Binding BulkLastDayLeave, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkCustNoLeave"
                                      Content="Bu hafta hiç izin verilmesin"
                                      IsChecked="{Binding NoLeaveForAll, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkCustOverlap"
                                      Content="İzin günlerinin çakışmasına izin ver"
                                      IsChecked="{Binding AllowLeaveOverlap, Mode=TwoWay}"
                                      Margin="0,0,0,10"/>

                            <WrapPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblRandomScope" Text="Rastgele İzin Kapsamı:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2,10,2"/>
                                <ComboBox x:Name="CmbRandomScope" Width="220" SelectionChanged="CmbRandomScope_SelectionChanged"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. Daily Shift Distribution -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="0">
                    <StackPanel>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="11" Padding="14,10">
                            <CheckBox x:Name="ChkDistCustomization"
                                      IsChecked="{Binding EnableDistributionCustomization, Mode=TwoWay}"
                                      Checked="SectionToggle_Changed"
                                      Unchecked="SectionToggle_Changed">
                                <TextBlock x:Name="TxtDistHeader"
                                           Text="Günlük Shift Sayıları"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Border>
                        <StackPanel Margin="14,12,14,14"
                                    Visibility="{Binding IsChecked, ElementName=ChkDistCustomization, Converter={StaticResource BoolToVis}}">
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                    <TextBlock x:Name="LblDailyMorning" Text="Günlük Sabahçı:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbDailyMorning" Width="76" SelectionChanged="CmbDailyCountChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock x:Name="LblDailyMid" Text="Günlük Ara Shift:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbDailyMid" Width="76" SelectionChanged="CmbDailyCountChanged"/>
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox x:Name="ChkTwoWorkerPreferEvening"
                                      Content="2 kişi kaldığında: 1 Sabahçı + 1 Akşamcı"
                                      IsChecked="{Binding TwoWorkerPreferEvening, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. Schedule Rules -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,10" Padding="0">
                    <StackPanel>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="11" Padding="14,10">
                            <CheckBox IsChecked="True" IsEnabled="False">
                                <TextBlock x:Name="TxtRulesHeader"
                                           Text="Shift Kuralları"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Border>
                        <StackPanel Margin="14,12,14,14">
                            <CheckBox x:Name="ChkRuleBeforeAfter"
                                      Content="İzin öncesi Sabahçı, izin sonrası Akşamcı"
                                      IsChecked="{Binding EnableRuleBeforeAfterLeave, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkRuleFair"
                                      Content="Sabahçı + Ara Shift eşit dağıtılsın"
                                      IsChecked="{Binding EnableFairEarlyDistribution, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkRuleHistory"
                                      Content="Önceki 2 haftayla farklılık sağla"
                                      IsChecked="{Binding EnableHistoryComparison, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkRuleHistoryRelax"
                                      Content="Gerektiğinde önceki hafta koşulunu esnet"
                                      IsChecked="{Binding AllowHistoryRelaxation, Mode=TwoWay}"
                                      Margin="22,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 7. Export Settings -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,4" Padding="0">
                    <StackPanel>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="11" Padding="14,10">
                            <CheckBox x:Name="ChkExportCustomization"
                                      IsChecked="{Binding EnableExportCustomization, Mode=TwoWay}"
                                      Checked="SectionToggle_Changed"
                                      Unchecked="SectionToggle_Changed">
                                <TextBlock x:Name="TxtExportHeader"
                                           Text="Görsel Çıktı (PNG / JPG) &amp; Tablo"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </CheckBox>
                        </Border>
                        <StackPanel Margin="14,12,14,14"
                                    Visibility="{Binding IsChecked, ElementName=ChkExportCustomization, Converter={StaticResource BoolToVis}}">
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="LblExportFormat" Text="Görsel Formatı:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2,10,2"/>
                                <ComboBox x:Name="CmbExportFormat" Width="190" SelectionChanged="CmbExportFormat_SelectionChanged">
                                    <ComboBoxItem Content="PNG" Tag="0"/>
                                    <ComboBoxItem Content="JPG" Tag="1"/>
                                </ComboBox>
                            </WrapPanel>
                            <CheckBox x:Name="ChkShowHours"
                                      Content="Hücre içinde mesai saatlerini göster"
                                      IsChecked="{Binding ShowHoursInTable, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkShowSummary"
                                      Content="Sağda özet sütunlarını göster"
                                      IsChecked="{Binding ShowSummaryColumns, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BtnResetDefaults"
                    Content="Varsayılana Sıfırla"
                    Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Left"
                    Click="BtnResetDefaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Content="İptal"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave"
                        Content="✓ Uygula"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
